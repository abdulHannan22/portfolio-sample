{
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "portfolio.html",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "routes": [
    {
      "src": "/$",
      "dest": "/portfolio.html"
    },
    {
      "src": "^/portfolio\\.html$",
      "dest": "/portfolio.html"
    },
    {
      "src": "/(.*)",
      "dest": "/portfolio.html"
    }
  ]
}
